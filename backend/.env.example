NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
SESSION_TTL_MINUTES=60

# MySQL 8.0.16+; configurar una contraseña local antes de iniciar.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sgcp
DB_USER=sgcp_user
DB_PASSWORD=

# Opcional en desarrollo; obligatorio cuando NODE_ENV=production.
# Ruta absoluta al certificado CA de RDS instalado exclusivamente en EC2.
# Ejemplo de ruta: /etc/sgcp/certificados/rds-ca-bundle.pem
# Valida el certificado del servidor; no incorporar el archivo CA al repositorio.
DB_SSL_CA_PATH=
